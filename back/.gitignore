# Fichier  : back/.gitignore
# Rôle     : fichiers du back que Git ne suit pas (compilation, cache
#            Gradle, fichiers d'éditeur) ; modèle toptal.com gradle,java
#            complété
# Utilise  : rien
# Utilisé par : git, avec le .gitignore racine

# Created by https://www.toptal.com/developers/gitignore/api/gradle,java
# Edit at https://www.toptal.com/developers/gitignore?templates=gradle,java

### Java ###
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

### Gradle ###
.gradle
**/build/
!src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath
# Dossier de compilation d'Eclipse (était versionné à l'origine)
bin/

### Gradle Patch ###
# Java heap dump
*.hprof

# End of https://www.toptal.com/developers/gitignore/api/gradle,java