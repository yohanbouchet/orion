# Fichier  : back/.dockerignore
# Rôle     : fichiers exclus du contexte de construction de l'image back :
#            construction plus rapide, aucun fichier local ou secret copié.
#            Seul le jar de l'application est envoyé à Docker.
# Utilise  : rien
# Utilisé par : docker build (contexte back/)

# Tout est exclu par défaut…
*
# … sauf le jar produit par `./gradlew bootJar` (le « ! » réintègre)
!build/libs/microcrm-*.jar
# Jamais le jar sans dépendances (tâche jar de Gradle), qui ne démarre pas
build/libs/*-plain.jar
