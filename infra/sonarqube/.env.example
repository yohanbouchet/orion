# Fichier  : infra/sonarqube/.env.example
# Rôle     : modèle du fichier .env (variables lues par compose.yaml).
#            Copier en .env, puis remplacer chaque valeur ; le vrai .env
#            n'est JAMAIS commité (voir .gitignore).
# Utilise  : rien
# Utilisé par : docker compose (infra/sonarqube/compose.yaml)

# Mot de passe du compte « sonarqube » de la base PostgreSQL.
# À générer, sans l'afficher, avec :
#   printf 'SONARQUBE_DB_PASSWORD=%s\n' "$(openssl rand -hex 32)" > .env
SONARQUBE_DB_PASSWORD=change-me
