{
  "uid": "orion-delivery",
  "title": "Orion - Delivery",
  "description": "DORA metrics of the production (delivery performance).",
  "tags": [
    "orion"
  ],
  "timezone": "browser",
  "refresh": "5m",
  "schemaVersion": 41,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "count by (image_spec) (kube_pod_container_info{namespace=\"prod\",container=~\"front|back\"}) unless count by (image_spec) (kube_pod_container_info{namespace=\"prod\",container=~\"front|back\"} offset 5m)",
        "step": "1m",
        "titleFormat": "Deployment",
        "textFormat": "{{image_spec}}",
        "tagKeys": "image_spec"
      }
    ]
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "Deployment frequency (per week)",
      "description": "Successful production deployments per week over the last 30 days (scripts/dora.py). DORA elite: on demand, several per day.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "last_over_time(dora_deployment_frequency_per_week{environment=\"production\",window_days=\"30\"}[$__range])",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Change lead time (median)",
      "description": "Median time from a commit to its production deployment. DORA elite: less than one day.",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "last_over_time(dora_change_lead_time_hours{environment=\"production\",window_days=\"30\"}[$__range])",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 24
              },
              {
                "color": "red",
                "value": 168
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Change fail rate",
      "description": "Production deployments that failed or during which an incident ticket was opened.",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "last_over_time(dora_change_fail_ratio{environment=\"production\",window_days=\"30\"}[$__range])",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.15
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Recovery time (median)",
      "description": "Median time from opening to closing an incident ticket. No data: no production incident declared.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "last_over_time(dora_recovery_time_hours{environment=\"production\",window_days=\"30\"}[$__range])",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 24
              }
            ]
          },
          "noValue": "No incident"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "Deployment rework rate",
      "description": "Production deployments that only deliver fixes (fix commits), among successful ones.",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "last_over_time(dora_rework_ratio{environment=\"production\",window_days=\"30\"}[$__range])",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "Deployments counted",
      "description": "Production deployments in the 30-day window (successful or not).",
      "type": "stat",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "last_over_time(dora_deployments{environment=\"production\",window_days=\"30\"}[$__range])",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 7,
      "title": "Frequency and lead time over time",
      "description": "Each point is one run of the DORA workflow (working days). Deployment marks come from the production pods.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "dora_deployment_frequency_per_week{environment=\"production\",window_days=\"30\"}",
          "legendFormat": "deployments per week"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "dora_change_lead_time_hours{environment=\"production\",window_days=\"30\"}",
          "legendFormat": "lead time (h)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "showPoints": "always",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Fail and rework rates over time",
      "description": "Each point is one run of the DORA workflow (working days).",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "dora_change_fail_ratio{environment=\"production\",window_days=\"30\"}",
          "legendFormat": "change fail rate"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "dora_rework_ratio{environment=\"production\",window_days=\"30\"}",
          "legendFormat": "rework rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "showPoints": "always",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "About these figures",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Computed from GitHub (production deployments, delivered commits, `incident` tickets) by `scripts/dora.py`, run by the **DORA metrics** workflow on working days, then imported into VictoriaMetrics. 30-day window: while production is younger than 30 days, the frequency is under-estimated. Blue marks: a new front or back image started in production."
      }
    }
  ]
}
