# Fichier  : /etc/fail2ban/jail.d/sshd.local (géré par Ansible :
#            infra/ansible/roles/hardening, ne pas modifier ici)
# Rôle     : bannit une heure toute adresse qui rate 5 connexions SSH en
#            10 minutes (essais de mots de passe)

[sshd]
enabled = true
# Ubuntu journalise SSH dans le journal de systemd
backend = systemd
maxretry = 5
findtime = 10m
bantime = 1h
